[Unit]
Description=Sync Zdrowa Polska employee signatures from GitHub Pages
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zp-signature
Group=zp-signature
Environment=ZP_SIGNATURE_BUNDLE_BASE=https://zdrowa-polska.github.io/zdrowa-polska-signatures/gateway-signatures
Environment=ZP_EMPLOYEE_SIGNATURES_FILE=/opt/zp-signature-gateway/employee-signatures.json
Environment=ZP_CORPORATE_DOMAIN=zdrowapolskagroup.pl
ExecStart=/opt/zp-signature-gateway/venv/bin/python /opt/zp-signature-gateway/sync_employee_signatures.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
